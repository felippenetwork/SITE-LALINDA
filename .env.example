# Copie este arquivo para .env e preencha os valores reais.
# Nunca commite .env (já está no .gitignore).

# --- Supabase ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Formulário de contato (anti-spam) ---
# Assina o token de timestamp do LeadForm — qualquer string aleatória longa.
LEAD_FORM_SECRET=

# --- Cifragem de credenciais (Bradesco, WhatsApp) ---
# 32 bytes aleatórios em base64. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Nunca trocar depois de já existir credencial cifrada salva com ela.
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=

# --- Resend (e-mail de notificação de lead) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Bradesco PIX ---
BRADESCO_PIX_TOKEN_URL=
BRADESCO_PIX_COB_URL=
BRADESCO_PIX_CHAVE=
# Segredo próprio (não vem do Bradesco) usado na URL do webhook de
# confirmação de pagamento. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BRADESCO_PIX_WEBHOOK_SECRET=

# --- UAZAPI (notificação de pedido confirmado via WhatsApp) ---
UAZAPI_URL=
UAZAPI_ADMIN_TOKEN=
